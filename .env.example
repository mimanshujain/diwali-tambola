POSTGRES_USER=tambola
POSTGRES_PASSWORD=replace-with-a-long-random-value
POSTGRES_DB=tambola

# Generate a private random token with: openssl rand -hex 32
ADMIN_TOKEN=replace-with-a-long-secret-admin-token

# For public guest access, follow docs/PUBLIC_GUEST_ACCESS.md.
# PUBLIC_GUEST_ORIGIN=https://play.example.com
# CLOUDFLARE_TUNNEL_TOKEN=

# Optional live commentary providers. Leave blank for factual commentary and TV browser speech.
# Create a Gemini API key in Google AI Studio; never commit your real .env.
GEMINI_API_KEY=
# Create an ElevenLabs API key and choose voice IDs from voices available to your account.
ELEVENLABS_API_KEY=
COMMENTARY_ELEVEN_VOICE_EN_US=
COMMENTARY_ELEVEN_VOICE_EN_IN=
COMMENTARY_ELEVEN_VOICE_HI_IN=
COMMENTARY_ELEVEN_VOICE_HI_US=
# Only a voice you have permission to use; see docs/COMMENTARY.md.
COMMENTARY_ELEVEN_VOICE_LICENSED=
